# Copy to .env, fill in, then: chmod 600 .env
#
# Every value here is read by the server only. Nothing in this file may appear
# in an HTTP response body. /api/health reports key_present and key_len -- never
# the key itself.
#
# Data leaves this machine: recordings go to the transcription provider and
# transcripts go to the scoring model. That is the point of the tool, but it is
# a departure from the sibling tools on this box, so it is stated here plainly.

# ── server ──────────────────────────────────────────────────────────────
# The product was L1 Support QA until 0.30.0: the old L1QA_* names still work (a new name wins)
# and the Server tab lists any still in use. Rename them when convenient.
AUDITLY_PORT=8084                  # 8081 cfbuilder, 8082 coeo, 8083 calculator are taken
AUDITLY_HOST=                      # the host name restart.sh prints in its links and puts in the self-signed certificate; blank = hostname -f
AUDITLY_BIND=127.0.0.1             # nginx fronts it; 0.0.0.0 only for LAN testing
AUDITLY_DB=./auditly.db               # relative paths resolve against the project folder
AUDITLY_UPLOAD_DIR=./uploads       # created mode 700
AUDITLY_MAX_UPLOAD_MB=200          # nginx client_max_body_size must be >= this
AUDITLY_RETENTION_DAYS=90          # audio files older than this are deleted; 0 = never.
                                # Transcripts and scorecards are kept.
AUDITLY_SESSION_HOURS=12
AUDITLY_INSECURE_COOKIES=0         # 1 drops the Secure flag from the cookie; localhost dev only
AUDITLY_WORKERS=1                  # background job threads
AUDITLY_MAX_TRANSCRIPT_CHARS=120000  # longer transcripts are middle-truncated before scoring
AUDITLY_VOICE_AI_NAME=Emma           # the voice AI that answers calls first; the scorer labels it and never scores its turns
AUDITLY_TARGET_PCT=90                # the QA score the Dashboard's pass rate and target line are measured against

# ── transcription ───────────────────────────────────────────────────────
TRANSCRIBE_PROVIDER=deepgram    # deepgram | openai  (a reviewer can override per upload)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
AUDITLY_STT_SENTIMENT=0         # 1 = also ask Deepgram for per-line sentiment (from the words, not the voice; English;
                                # billed per token on top of the minutes). Draws the dots and strips on the scorecard.
OPENAI_API_KEY=                 # used for OpenAI transcription AND OpenAI scoring
OPENAI_TRANSCRIBE_MODEL=whisper-1   # default for the OpenAI entry of the Transcribe menu; gpt-4o-transcribe is also offered
OPENAI_API_BASE=https://api.openai.com/v1

# ── scoring ─────────────────────────────────────────────────────────────
SCORING_PROVIDER=openai         # openai | anthropic
OPENAI_SCORING_MODEL=gpt-4o-mini      # default of the Audit menu (also offered: gpt-5.6-luna, gpt-4.1-mini)
ANTHROPIC_API_KEY=              # optional second provider
ANTHROPIC_MODEL=claude-sonnet-5       # confirm the current id in the Anthropic docs
SCORING_TEMPERATURE=0
SCORING_MAX_TOKENS=4000
SCORING_SEED=20260915           # OpenAI gpt-4 family only: fixed seed for repeatable audits (best effort); blank = not sent

# "Optimise for the scorer" (Settings › QA types › Optimise): one paid LLM call per run, manual only
AUDITLY_SYNC_MAX_RUNS_PER_VERSION=1  # runs allowed per QA type version; save a new version to optimise again
AUDITLY_SYNC_MAX_RUNS_PER_DAY=5      # runs allowed across the server per UTC day
AUDITLY_SYNC_WAIT_S=120              # an audit queued while an optimisation is running waits this long for it

# ── coaching invites by email (optional) ───────────────────────────────
# Leave SMTP_HOST empty and nothing is ever sent: the Coaching tab offers the .ics download and a
# mailto link instead. With a relay set, "Send invite" emails the agent a calendar request from
# SMTP_FROM with the QA as organiser / Reply-To. Microsoft 365: smtp.office365.com:587, STARTTLS,
# SMTP AUTH enabled for the mailbox. Google Workspace: smtp.gmail.com:587 with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                      # the sending mailbox, e.g. auditly@yourcompany.com
SMTP_STARTTLS=1                 # 0 only for a trusted internal relay on port 25
SMTP_SEND_AS_QA=0               # 1 = From: the QA's own address (the mailbox needs "Send As" rights for it)

# ── the agent's dispute link (0.52.0) ──────────────────────────────────
# When an audit is submitted, the agent (email under Settings › Names) is sent a link to a read-only
# copy of their scorecard where they can dispute a score themselves. Needs the relay above; without
# it, or without an address, the QA copies the link from the scorecard's "Dispute link" action.
AUDITLY_DISPUTE_LINK_DAYS=14    # how long a link works; 0 switches the feature off
AUDITLY_PUBLIC_URL=             # the address agents reach the app at, e.g. https://qa.company.com (no trailing slash);
                                # blank = the scheme and host the QA used, which is right when everyone uses one hostname

# Ask Auditly (assistant.py): questions about the open call, answered only from its record and cited.
# Off until an admin turns it on. Uses the scoring provider and the same spend gate as scoring.
ASK_ENABLED=0
ASK_API_KEY=                    # a separate OpenAI PROJECT key for the assistant (its own spend line and cap); blank = OPENAI_API_KEY
ASK_MODEL=                      # blank = OPENAI_SCORING_MODEL
ASK_MAX_TOKENS=700              # the answer's ceiling
ASK_MAX_PER_DAY=300             # questions per UTC day, server-wide
ASK_MAX_PER_USER_PER_HOUR=40    # per signed-in person
ASK_RETENTION_DAYS=90           # conversations older than this are deleted; 0 = never

# A second, encrypted listener from the app itself (browsers open a microphone only on a secure page).
# restart.sh sets AUDITLY_TLS_PORT=8444 and generates a self-signed pair into tls/ when none exists; point
# these at a real certificate's fullchain and key to stop the browser warning. 0 = off.
AUDITLY_TLS_PORT=0
AUDITLY_TLS_CERT=tls/auditly.crt
AUDITLY_TLS_KEY=tls/auditly.key

# ── safety interlocks ───────────────────────────────────────────────────
AUDITLY_ALLOW_SPEND=0              # must be exactly 1 before any provider is called.
                                # --demo mode needs no keys and never calls out -- but it also
                                # transcribes NOTHING: every upload gets the canned sample call.
AUDITLY_DEMO=0                     # 1 = fake providers + seeded sample data
AUDITLY_DEMO_HISTORY=1             # with --demo: also seed ~44 past calls so the Dashboard has trends (0 = just the one call)
AUDITLY_OPEN_ACCESS=0              # 1 = no sign-in: every visitor acts as open-access@local (admin).
                                # Demo/LAN only; deploy/install.sh refuses to install with it set.

# ── security ────────────────────────────────────────────────────────────
SESSION_SECRET=                 # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
